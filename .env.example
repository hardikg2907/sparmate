# Copy this file to `.env` (gitignored) to set options without exporting variables.
# Variables already set in the shell win over this file.

# Folder that holds TRACKER.md, REVIEW.md, TEACHING.md, notes/ and lld/.
# A missing or empty folder is filled from study-kit/ at start. Default: ~/sparmate-study
# STUDY_ROOT=/path/to/your/study-folder

# Sessions, settings, custom problems, logs and the Kokoro voice home. Default: <STUDY_ROOT>/rounds
# DATA_DIR=/path/to/round-data

# Server port. Default: 4747
# PORT=4747

# Folder with .venv/bin/python, kokoro-v1.0.onnx and voices-v1.0.bin for neural speech. Default: <DATA_DIR>/kokoro
# SPARMATE_KOKORO_HOME=/path/to/kokoro

# Extra terms the privacy guard must keep out of logs and files, one per line. Default: ~/.config/sparmate/denylist.txt
# SPARMATE_DENYLIST=/path/to/denylist.txt
