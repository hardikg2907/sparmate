{
  "name": "sparmate",
  "version": "0.1.0",
  "private": true,
  "description": "Local practice room for system design (HLD) and C++ machine-coding (LLD) interviews, with an AI interviewer, judge and coach.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hardikg2907/sparmate.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "vite build",
    "serve": "tsx src/server/index.ts",
    "start": "vite build && tsx src/server/index.ts",
    "dev": "concurrently -k -n web,server \"vite\" \"tsx watch src/server/index.ts\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "node scripts/verify.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.318",
    "@anthropic-ai/sdk": "1.4.0",
    "@excalidraw/excalidraw": "0.18.1",
    "@fastify/static": "10.1.10",
    "@fastify/websocket": "11.3.7",
    "@fontsource-variable/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@monaco-editor/react": "4.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "diff": "9.0.0",
    "fastify": "5.12.8",
    "monaco-editor": "0.57.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tsx": "4.23.15",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "concurrently": "10.0.6",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "puppeteer-core": "25.16.0",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "lodash-es": "4.18.1",
    "katex": "0.18.11",
    "nanoid@3": "3.3.20",
    "nanoid@4": "5.1.16",
    "@fastify/static": {
      "glob": "14.0.3"
    }
  }
}
